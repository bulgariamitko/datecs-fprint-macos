{
  "manifest_version": 3,
  "name": "Kasa Мениджър за Изтегляния",
  "version": "2.0",
  "description": "Автоматично организира kasa*.txt файлове в персонализирана папка в Downloads",
  "permissions": [
    "downloads",
    "downloads.shelf",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Настройки на Kasa"
  }
}